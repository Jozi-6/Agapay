# Backend API server port
PORT=3001

# JWT signing secret used by server/auth.js
JWT_SECRET=change-this-secret-in-real-environments

# Allowed CORS origins (comma-separated)
# For development: http://localhost:5173,http://127.0.0.1:5173
# For production: https://jozi-6.github.io
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://jozi-6.github.io

# Frontend API URL (for production GitHub Pages deployment)
# Development: leave empty or set to http://localhost:3001
# Production: set to your deployed backend URL (e.g., https://your-backend.herokuapp.com)
VITE_API_URL=

# Optional: override Vite dev proxy target for /api requests
# VITE_API_PROXY_TARGET=http://localhost:3001
